{
    "manifest_version": 3,
    "name": "RMG",
    "version": "1.0",
    "description": "Selects a random movie using TMDB",
    "action": {
        "default_title": "Random Movie Generator",
        "default_popup": "popup.html"
    },
    "host_permissions": [
        "https://api.themoviedb.org/*",
        "https://image.tmdb.org/*"
    ]
}